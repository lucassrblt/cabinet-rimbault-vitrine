PUBLIC_API_URL=http://localhost:3002/api/public
PUBLIC_API_KEY=

# Avis Google — API Places (New). Optionnelles : sans elles, les avis sont
# désactivés en production (et remplacés par des données de démo en local).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Gate « Site en cours de développement » — masque le site au public.
# Mettre à "on" pour activer (en prod uniquement). Vide / absent = désactivé.
MAINTENANCE_MODE=
# Token long et imprévisible (32+ caractères, ex. `openssl rand -hex 24`).
# Utilisé via ?preview=<TOKEN> pour poser un cookie de bypass de 30 jours.
MAINTENANCE_BYPASS_TOKEN=
