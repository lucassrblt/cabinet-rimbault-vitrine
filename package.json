{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-launch.ts",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "check:launch": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-launch.ts",
    "format": "biome format --write",
    "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./src/__tests__/register.mjs src/__tests__/*.test.ts src/lib/property/__tests__/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:ui": "playwright test --ui",
    "mock:api": "node e2e/mock-api.mjs"
  },
  "dependencies": {
    "lenis": "1.3.27",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
